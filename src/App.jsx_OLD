const StatusBadge = ({ status }) => {
  const s = { ingested:"bg-emerald-500/15 text-emerald-400 border-emerald-500/30", processing:"bg-amber-500/15 text-amber-400 border-amber-500/30", transcribing:"bg-cyan-500/15 text-cyan-400 border-cyan-500/30", approved:"bg-emerald-500/15 text-emerald-600 border-emerald-500/30", pending:"bg-amber-500/15 text-amber-600 border-amber-500/30", rejected:"bg-red-500/15 text-red-500 border-red-500/30", open:"bg-red-500/15 text-red-500 border-red-500/30", investigating:"bg-amber-500/15 text-amber-600 border-amber-500/30", "fix-in-progress":"bg-cyan-500/15 text-cyan-600 border-cyan-500/30", verified:"bg-emerald-500/15 text-emerald-600 border-emerald-500/30", critical:"bg-red-500/20 text-red-500 border-red-500/40", high:"bg-orange-500/15 text-orange-500 border-orange-500/30", medium:"bg-amber-500/15 text-amber-600 border-amber-500/30", low:"bg-emerald-500/15 text-emerald-600 border-emerald-500/30" };
  return <span className={`px-2 py-0.5 rounded-full text-xs font-medium border ${s[status]||"bg-slate-500/15 text-slate-400 border-slate-500/30"}`}>{status.replace(/-/g," ")}</span>;
};
const FileIcon = ({ type }) => {
  const I = { PDF:File, PPTX:FileText, XLSX:FileSpreadsheet, DOCX:FileText, MP4:Video }; const c = { PDF:"text-red-400",PPTX:"text-orange-400",XLSX:"text-emerald-400",DOCX:"text-blue-400",MP4:"text-purple-400" };
  const Ic = I[type]||File; return <Ic size={18} className={c[type]||"text-slate-400"} />;
};
const StatCard = ({ label, value, change, trend, icon }) => {
  const m = { zap:Zap, brain:Brain, bug:Bug, target:Target, file:FileText, database:Database, refresh:RefreshCw, check:CheckCircle, clock:Clock, shield:Shield, layers:Layers }; const Ic = m[icon]||Activity;
  return (<div className="rounded-xl p-4 border bg-white border-slate-200 shadow-sm"><div className="flex items-start justify-between mb-3"><div className="w-9 h-9 rounded-lg flex items-center justify-center bg-cyan-50"><Ic size={18} className="text-cyan-500" /></div>{change && <span className="text-xs font-medium px-1.5 py-0.5 rounded text-emerald-500 bg-emerald-500/10">{change}</span>}</div><div className="text-2xl font-bold mb-0.5 text-slate-800">{value}</div><div className="text-xs text-slate-500">{label}</div></div>);
};
const MiniProgressBar = ({ value, color="bg-cyan-500" }) => (<div className="w-full h-1.5 rounded-full bg-slate-100"><div className={`h-full rounded-full ${color} transition-all duration-700`} style={{width:`${Math.min(value,100)}%`}} /></div>);

/* ═══════════════════════════════════════════════════════════════ */
/*  LANDING PAGE                                                   */
/* ═══════════════════════════════════════════════════════════════ */
const LandingPage = ({ onLaunch }) => {
  const [scrollY, setScrollY] = useState(0);
  const [visible, setVisible] = useState(new Set());
  const cRef = useRef(null);
  useEffect(() => { const c=cRef.current; if(!c) return; const h=()=>setScrollY(c.scrollTop); c.addEventListener("scroll",h,{passive:true}); return ()=>c.removeEventListener("scroll",h); },[]);
  useEffect(() => {
    const obs = new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting) setVisible(p=>new Set(p).add(e.target.dataset.rid))})},{threshold:0.1,rootMargin:"0px 0px -30px 0px"});
    document.querySelectorAll("[data-rid]").forEach(el=>obs.observe(el)); return ()=>obs.disconnect();
  },[]);
  const rv = (id,d=0) => ({"data-rid":id, style:{opacity:visible.has(id)?1:0, transform:visible.has(id)?"translateY(0)":"translateY(36px)", transition:`opacity 0.75s cubic-bezier(0.16,1,0.3,1) ${d}s, transform 0.75s cubic-bezier(0.16,1,0.3,1) ${d}s`}});
  const scrollTo = (id) => (e) => { e.preventDefault(); document.getElementById(id)?.scrollIntoView({behavior:"smooth"}); };

  const caps = [
    { n:"01",icon:<FileSearch size={22} className="text-cyan-400"/>,t:"Requirement Analysis",d:"Parses specs, detects ambiguities, identifies testable requirements, generates traceability matrices." },
    { n:"02",icon:<Zap size={22} className="text-cyan-400"/>,t:"Test Case Generation",d:"Specification-driven, exploratory, boundary, and regression tests with domain context." },
    { n:"03",icon:<Database size={22} className="text-cyan-400"/>,t:"Test Data Generation",d:"Synthetic data respecting PLM models — BOM hierarchies, constraints, state machines." },
    { n:"04",icon:<RefreshCw size={22} className="text-amber-400"/>,t:"Execution Orchestration",d:"Intelligent sequencing, parallel execution, environment management, auto-retry." },
    { n:"05",icon:<Bug size={22} className="text-red-400"/>,t:"Defect Analysis",d:"Auto-classification, duplicate detection, predictive flagging, trend analysis." },
    { n:"06",icon:<GitBranch size={22} className="text-emerald-400"/>,t:"Regression Coverage",d:"Impact analysis mapping code changes to tests. Optimal suite selection." },
  ];

  return (
    <div ref={cRef} className="h-screen overflow-y-auto" style={{background:"#060d1f",scrollbarWidth:"thin",scrollbarColor:"#1e293b #060d1f"}}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap');
        @keyframes pglow{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.3)}}
        @keyframes fp{0%{opacity:0;transform:translateY(0) scale(0)}10%{opacity:.5;transform:scale(1)}90%{opacity:0}100%{opacity:0;transform:translateY(-350px) scale(0)}}
        .ls{font-family:'Instrument Serif',Georgia,serif} .lm{font-family:'JetBrains Mono',monospace}
      `}</style>

      {/* Nav */}
      <nav className="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 transition-all duration-300" style={{padding:scrollY>50?"0.7rem 2rem":"1.1rem 2rem",background:scrollY>50?"rgba(6,13,31,0.92)":"rgba(6,13,31,0.5)",backdropFilter:"blur(20px) saturate(180%)",borderBottom:`1px solid ${scrollY>50?"rgba(8,145,178,0.12)":"rgba(255,255,255,0.03)"}`}}>
        <div className="flex items-center gap-3"><div className="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center"><Brain size={17} className="text-white" /></div><span className="ls text-white text-lg">AI QA Worker</span></div>
        <div className="flex items-center gap-8">
          <a href="#cap-s" onClick={scrollTo("cap-s")} className="text-sm text-slate-400 hover:text-cyan-400 transition-colors hidden md:block cursor-pointer">Capabilities</a>
          <a href="#know-s" onClick={scrollTo("know-s")} className="text-sm text-slate-400 hover:text-cyan-400 transition-colors hidden md:block cursor-pointer">Knowledge Engine</a>
          <a href="#met-s" onClick={scrollTo("met-s")} className="text-sm text-slate-400 hover:text-cyan-400 transition-colors hidden md:block cursor-pointer">Impact</a>
          <button onClick={onLaunch} className="px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-semibold hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-500/20 flex items-center gap-2">Launch Dashboard <ArrowRight size={14}/></button>
        </div>
      </nav>

      {/* Hero */}
      <section className="min-h-screen flex flex-col items-center justify-center text-center px-6 pt-24 pb-16 relative overflow-hidden">
        <div className="absolute inset-0" style={{backgroundImage:"linear-gradient(rgba(8,145,178,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(8,145,178,0.05) 1px,transparent 1px)",backgroundSize:"60px 60px",maskImage:"radial-gradient(ellipse 80% 60% at 50% 40%,black 20%,transparent 70%)",WebkitMaskImage:"radial-gradient(ellipse 80% 60% at 50% 40%,black 20%,transparent 70%)"}} />
        <div className="absolute top-[-200px] left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full pointer-events-none" style={{background:"radial-gradient(circle,rgba(8,145,178,0.1) 0%,transparent 65%)"}} />
        <div className="absolute bottom-[-100px] right-[-100px] w-[500px] h-[500px] rounded-full pointer-events-none" style={{background:"radial-gradient(circle,rgba(245,158,11,0.05) 0%,transparent 65%)"}} />
        {[15,32,55,72,88,44].map((l,i)=>(<div key={i} className="absolute w-1 h-1 rounded-full bg-cyan-400 pointer-events-none" style={{left:`${l}%`,bottom:`${10+i*5}%`,animation:`fp 9s ease-in ${i*1.3}s infinite`}} />))}

        <div {...rv("hb")}><div className="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-cyan-500/25 bg-cyan-500/8 text-cyan-400 text-xs font-medium tracking-wider uppercase mb-8"><span className="w-1.5 h-1.5 rounded-full bg-cyan-400" style={{animation:"pglow 2s ease-in-out infinite"}} />Enterprise AI for Quality Engineering</div></div>
        <h1 {...rv("ht",0.1)} className="ls text-white text-5xl md:text-7xl leading-none tracking-tight mb-6 max-w-4xl" style={{letterSpacing:"-0.02em"}}>Your QA team's{" "}<em className="italic bg-gradient-to-r from-cyan-400 to-cyan-300 bg-clip-text text-transparent">expertise,</em>{" "}amplified by AI</h1>
        <p {...rv("hs",0.2)} className="text-slate-400 text-lg md:text-xl max-w-2xl leading-relaxed mb-10 font-light">An intelligent virtual worker that ingests your domain knowledge and testing expertise — then autonomously generates test cases, predicts defects, and drives quality across your Digital Manufacturing & PLM platform.</p>
        <div {...rv("hb2",0.3)} className="flex items-center gap-4 flex-wrap justify-center">
          <button onClick={onLaunch} className="px-7 py-3.5 bg-cyan-600 text-white rounded-xl text-base font-semibold hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-500/25 hover:-translate-y-0.5 flex items-center gap-2"><Zap size={18}/>Launch Dashboard</button>
          <a href="#cap-s" onClick={scrollTo("cap-s")} className="px-7 py-3.5 rounded-xl text-base font-medium text-slate-300 border border-white/10 hover:border-cyan-500/30 hover:bg-cyan-500/5 transition-all flex items-center gap-2 cursor-pointer">Explore Capabilities <ArrowUpRight size={16}/></a>
        </div>
        <div {...rv("hm",0.45)} className="flex gap-10 md:gap-16 mt-20 pt-10 border-t border-white/5 flex-wrap justify-center">
          {[{v:"–70%",l:"Test creation time"},{v:"+40%",l:"Regression coverage"},{v:"–50%",l:"Defect escape rate"},{v:"91%",l:"AI accuracy vs human"}].map((m,i)=>(<div key={i} className="text-center"><div className="ls text-3xl md:text-4xl text-white">{m.v.replace("%","")}<span className="text-cyan-400">%</span></div><div className="text-xs text-slate-500 mt-1">{m.l}</div></div>))}
        </div>
      </section>

      {/* Problem */}
      <section className="max-w-6xl mx-auto px-6 py-24">
        <div {...rv("ph")}><p className="lm text-xs text-cyan-500 tracking-widest uppercase mb-3">// The Challenge</p><h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-3" style={{letterSpacing:"-0.02em"}}>Two layers of expertise.<br/><em className="italic text-cyan-400">Impossible to scale.</em></h2><p className="text-slate-400 text-lg max-w-xl leading-relaxed font-light">Your QA engineers carry deep domain knowledge in PLM and testing methodology — expertise that takes years to build and vanishes when people leave.</p><div className="w-14 h-0.5 bg-gradient-to-r from-cyan-500 to-transparent mt-5"/></div>
        <div className="grid md:grid-cols-2 gap-5 mt-14">
          {[{e:"🏭",t:"Domain Knowledge Trap",d:"PLM spans 100+ modules. Each requires years of understanding. When experts leave, knowledge walks out the door.",dy:0.1},{e:"🧪",t:"Testing Bottleneck",d:"Manual test creation is slow. Regression consumes 40%+ of capacity. Quality gaps widen as velocity increases.",dy:0.2},{e:"⏱️",t:"12–18 Month Ramp-Up",d:"New QA engineers need over a year on complex PLM platforms. Release velocity can't wait.",dy:0.3},{e:"🔗",t:"Broken Traceability",d:"Requirements, tests, defects live in disconnected systems. Coverage gaps hide in the seams.",dy:0.4}].map((c,i)=>(<div key={i} {...rv(`p${i}`,c.dy)} className="p-6 rounded-2xl border border-white/5 hover:border-cyan-500/15 transition-all duration-300 hover:-translate-y-1" style={{background:"linear-gradient(160deg,rgba(11,26,58,0.5),rgba(6,13,31,0.95))"}}><div className="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/15 flex items-center justify-center text-xl mb-4">{c.e}</div><h3 className="ls text-white text-xl mb-2">{c.t}</h3><p className="text-slate-400 text-sm leading-relaxed">{c.d}</p></div>))}
        </div>
      </section>

      {/* Capabilities */}
      <section id="cap-s" className="max-w-6xl mx-auto px-6 py-24">
        <div {...rv("ch")}><p className="lm text-xs text-cyan-500 tracking-widest uppercase mb-3">// Capabilities</p><h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-3" style={{letterSpacing:"-0.02em"}}>Seven AI-powered capabilities.<br/><em className="italic text-cyan-400">One virtual worker.</em></h2><p className="text-slate-400 text-lg max-w-xl leading-relaxed font-light">Each powered by domain-aware AI reasoning over your actual product knowledge.</p><div className="w-14 h-0.5 bg-gradient-to-r from-cyan-500 to-transparent mt-5"/></div>
        <div className="grid md:grid-cols-3 gap-4 mt-14">
          {caps.map((c,i)=>(<div key={i} {...rv(`c${i}`,i*0.08)} className="p-5 rounded-2xl border border-white/5 hover:border-cyan-500/20 transition-all duration-400 hover:-translate-y-1 group relative overflow-hidden" style={{background:"linear-gradient(160deg,rgba(11,26,58,0.45),rgba(6,13,31,0.95))"}}><div className="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-cyan-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"/><p className="lm text-xs text-cyan-600 tracking-wider mb-3">{c.n}</p><div className="w-10 h-10 rounded-xl bg-cyan-500/8 border border-cyan-500/12 flex items-center justify-center mb-3">{c.icon}</div><h3 className="ls text-white text-lg mb-1.5">{c.t}</h3><p className="text-slate-400 text-sm leading-relaxed">{c.d}</p></div>))}
        </div>
        <div className="flex justify-center mt-4"><div {...rv("c6",0.5)} className="p-5 rounded-2xl border border-amber-500/12 hover:border-amber-500/25 transition-all hover:-translate-y-1 group relative overflow-hidden max-w-sm w-full" style={{background:"linear-gradient(160deg,rgba(30,20,5,0.5),rgba(6,13,31,0.95))"}}><div className="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-amber-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"/><p className="lm text-xs text-amber-500 tracking-wider mb-3">07</p><div className="w-10 h-10 rounded-xl bg-amber-500/8 border border-amber-500/12 flex items-center justify-center mb-3"><BarChart3 size={22} className="text-amber-400"/></div><h3 className="ls text-white text-lg mb-1.5">Quality Insights & Reporting</h3><p className="text-slate-400 text-sm leading-relaxed">Real-time dashboards, release readiness scoring, predictive alerts, auto-generated summaries.</p></div></div>
      </section>

      {/* Knowledge Engine */}
      <section id="know-s" className="max-w-6xl mx-auto px-6 py-24">
        <div {...rv("kh")}><p className="lm text-xs text-cyan-500 tracking-widest uppercase mb-3">// Knowledge Engine</p><h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-3" style={{letterSpacing:"-0.02em"}}>Feed it everything.<br/><em className="italic text-cyan-400">It learns your world.</em></h2><p className="text-slate-400 text-lg max-w-xl leading-relaxed font-light">From PowerPoint decks to training videos — the AI ingests, chunks, embeds, and indexes every document format your teams use.</p><div className="w-14 h-0.5 bg-gradient-to-r from-cyan-500 to-transparent mt-5"/></div>
        <div {...rv("kp",0.15)} className="flex items-center justify-center gap-0 mt-14 flex-wrap">
          {[{l:"Sources",s:"PPT · PDF · Excel · Video",c:"bg-cyan-500/10 border-cyan-500/20 text-cyan-400"},null,{l:"Processing",s:"Parse · Transcribe · Chunk · Embed",c:"bg-amber-500/8 border-amber-500/18 text-amber-400"},null,{l:"Knowledge Store",s:"Vectors · Graph · Full Text",c:"bg-emerald-500/8 border-emerald-500/18 text-emerald-400"},null,{l:"AI QA Agent",s:"RAG + Reasoning",c:"bg-gradient-to-r from-cyan-600 to-cyan-700 border-cyan-500/30 text-white shadow-lg shadow-cyan-500/15"}].map((n,i)=>n===null?<div key={i} className="px-2 text-cyan-500/40 text-lg hidden md:block">→</div>:<div key={i} className={`px-5 py-3 rounded-xl border text-center min-w-[130px] ${n.c}`}><div className="text-xs font-semibold tracking-wide">{n.l}</div><div className="text-xs opacity-65 mt-0.5">{n.s}</div></div>)}
        </div>
        <div {...rv("kt",0.25)} className="flex flex-wrap gap-2 justify-center mt-8">{[".pdf",".pptx",".docx",".xlsx",".csv",".mp4",".py",".java",".json",".xml",".sql"].map(f=><span key={f} className="lm text-xs px-3 py-1.5 rounded-full border border-white/6 bg-white/2 text-slate-500">{f}</span>)}</div>
        <div className="grid md:grid-cols-2 gap-5 mt-14">
          <div {...rv("kd",0.1)} className="p-6 rounded-2xl border border-cyan-500/10 hover:border-cyan-500/20 transition-all" style={{background:"linear-gradient(160deg,rgba(11,26,58,0.5),rgba(6,13,31,0.95))"}}><div className="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/15 flex items-center justify-center text-xl mb-4">🏗️</div><h3 className="ls text-white text-xl mb-2">Domain Expertise Ingested</h3><p className="text-slate-400 text-sm leading-relaxed">Product ontologies, business rules, process models, compliance requirements, integration maps — all extracted, structured, and indexed.</p></div>
          <div {...rv("ke",0.2)} className="p-6 rounded-2xl border border-amber-500/10 hover:border-amber-500/20 transition-all" style={{background:"linear-gradient(160deg,rgba(30,20,5,0.3),rgba(6,13,31,0.95))"}}><div className="w-12 h-12 rounded-xl bg-amber-500/8 border border-amber-500/15 flex items-center justify-center text-xl mb-4">🧪</div><h3 className="ls text-white text-xl mb-2">Testing Expertise Ingested</h3><p className="text-slate-400 text-sm leading-relaxed">Test design patterns, automation frameworks, defect taxonomies, risk models, execution strategies — encoded as AI reasoning templates.</p></div>
        </div>
      </section>

      {/* Metrics */}
      <section id="met-s" className="max-w-6xl mx-auto px-6 py-24 text-center">
        <div {...rv("mh")}><p className="lm text-xs text-cyan-500 tracking-widest uppercase mb-3">// Projected Impact</p><h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-3" style={{letterSpacing:"-0.02em"}}>Numbers that <em className="italic text-cyan-400">move the needle</em></h2><p className="text-slate-400 text-base font-light">18-month projections based on enterprise benchmarks</p></div>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mt-14">
          {[{v:"–70%",l:"Test creation time",s:"5 days → 4 hours",c:"text-cyan-400"},{v:"+40%",l:"Regression coverage",s:"45% → 95%",c:"text-amber-400"},{v:"–50%",l:"Defect escape rate",s:"6.4% → 3.2%",c:"text-emerald-400"},{v:"46%",l:"Net ROI at 18 months",s:"~10 month payback",c:"text-white"}].map((m,i)=>(<div key={i} {...rv(`m${i}`,i*0.1)} className="p-6 rounded-2xl border border-white/5 hover:border-cyan-500/15 transition-all hover:-translate-y-1" style={{background:"linear-gradient(160deg,rgba(11,26,58,0.4),rgba(6,13,31,0.95))"}}><div className={`ls text-4xl md:text-5xl leading-none ${m.c}`}>{m.v}</div><div className="text-sm text-slate-400 mt-2">{m.l}</div><div className="lm text-xs text-slate-600 mt-1">{m.s}</div></div>))}
        </div>
      </section>

      {/* Roadmap */}
      <section className="max-w-6xl mx-auto px-6 py-24 text-center">
        <div {...rv("rh")}><p className="lm text-xs text-cyan-500 tracking-widest uppercase mb-3">// Implementation</p><h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-3" style={{letterSpacing:"-0.02em"}}>18 months to <em className="italic text-cyan-400">full deployment</em></h2><p className="text-slate-400 text-base font-light">Five phased gates — POC to enterprise-wide autonomy</p></div>
        <div {...rv("rt",0.15)} className="flex items-center justify-center mt-14 relative gap-0">
          <div className="absolute top-1/2 left-[10%] right-[10%] h-px hidden md:block" style={{background:"linear-gradient(90deg,#0891B2,#F59E0B,#10B981)",opacity:0.25}}/>
          {[{n:"1",t:"Foundation",m:"M1–3",c:"#0891B2"},{n:"2",t:"POC & Validate",m:"M4–6",c:"#0E7490"},{n:"3",t:"Core Build",m:"M7–10",c:"#F59E0B"},{n:"4",t:"Scale",m:"M11–14",c:"#F97316"},{n:"5",t:"Enterprise",m:"M15–18",c:"#10B981"}].map((p,i)=>(<div key={i} className="flex-1 text-center relative z-10 px-1"><div className="w-3.5 h-3.5 rounded-full mx-auto mb-3" style={{background:p.c,boxShadow:`0 0 12px ${p.c}40`,outline:`2px solid ${p.c}40`,outlineOffset:"3px"}} /><p className="lm text-xs tracking-wider mb-1" style={{color:p.c}}>Phase {p.n}</p><p className="ls text-white text-sm md:text-base">{p.t}</p><p className="lm text-xs text-slate-500 mt-0.5">{p.m}</p></div>))}
        </div>
      </section>

      {/* CTA */}
      <section className="max-w-4xl mx-auto px-6 py-28 text-center relative">
        <div className="absolute inset-0 pointer-events-none" style={{background:"radial-gradient(ellipse 60% 50% at 50% 50%,rgba(8,145,178,0.07),transparent)"}}/>
        <div {...rv("cta")} className="relative z-10">
          <h2 className="ls text-white text-4xl md:text-5xl leading-tight mb-4" style={{letterSpacing:"-0.02em"}}>Ready to <em className="italic text-cyan-400">transform</em> your QA?</h2>
          <p className="text-slate-400 text-lg max-w-lg mx-auto leading-relaxed mb-10 font-light">Capture your team's expertise, amplify it with AI, make it available around the clock.</p>
          <div className="flex items-center gap-4 justify-center flex-wrap">
            <button onClick={onLaunch} className="px-8 py-4 bg-cyan-600 text-white rounded-xl text-base font-semibold hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-500/25 hover:-translate-y-0.5 flex items-center gap-2"><Monitor size={18}/>Launch the Dashboard</button>
            <button className="px-8 py-4 rounded-xl text-base font-medium text-slate-300 border border-white/10 hover:border-cyan-500/30 hover:bg-cyan-500/5 transition-all flex items-center gap-2"><Download size={16}/>Download Program Brief</button>
          </div>
        </div>
      </section>

      <footer className="max-w-6xl mx-auto px-6 py-8 border-t border-white/4 flex items-center justify-between"><p className="text-xs text-slate-600">© 2026 AI Virtual QA Worker</p><div className="flex gap-6"><span className="text-xs text-slate-500 hover:text-cyan-400 cursor-pointer">Privacy</span><span className="text-xs text-slate-500 hover:text-cyan-400 cursor-pointer">Terms</span><span className="text-xs text-slate-500 hover:text-cyan-400 cursor-pointer">Contact</span></div></footer>
    </div>
  );
};

/* ═══════════════════════════════════════════════════════════════ */
/*  DASHBOARD PAGES                                                */
/* ═══════════════════════════════════════════════════════════════ */
const DashboardPage = () => { const d=MOCK_DASHBOARD; return (<div className="space-y-5"><div className="flex items-center justify-between"><div><h1 className="text-xl font-bold text-slate-800">Command Center</h1><p className="text-sm text-slate-500 mt-0.5">AI Virtual QA Worker — Real-time Overview</p></div><div className="flex items-center gap-2"><span className="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-600 rounded-lg text-xs font-medium border border-emerald-200"><span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"/>All Systems Operational</span><button className="px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-600 hover:bg-slate-50 flex items-center gap-1.5 shadow-sm"><RefreshCw size={12}/>Refresh</button></div></div><div className="grid grid-cols-4 gap-3">{d.stats.map((s,i)=><StatCard key={i} {...s}/>)}</div><div className="grid grid-cols-3 gap-4"><div className="col-span-2 bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><div className="flex items-center justify-between mb-3"><h3 className="text-sm font-semibold text-slate-700">Coverage & Test Growth Trend</h3><span className="text-xs text-slate-400">Last 7 months</span></div><ResponsiveContainer width="100%" height={220}><AreaChart data={d.coverageTrend}><defs><linearGradient id="cG" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#0891B2" stopOpacity={0.2}/><stop offset="95%" stopColor="#0891B2" stopOpacity={0}/></linearGradient></defs><CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9"/><XAxis dataKey="month" tick={{fontSize:11,fill:"#94A3B8"}}/><YAxis tick={{fontSize:11,fill:"#94A3B8"}} domain={[50,100]}/><Tooltip contentStyle={{borderRadius:8,border:"1px solid #e2e8f0",fontSize:12}}/><Area type="monotone" dataKey="coverage" stroke="#0891B2" fill="url(#cG)" strokeWidth={2.5} dot={{r:3,fill:"#0891B2"}} name="Coverage %"/></AreaChart></ResponsiveContainer></div><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Defects by Category</h3><ResponsiveContainer width="100%" height={180}><PieChart><Pie data={d.defectsByCategory} cx="50%" cy="50%" innerRadius={45} outerRadius={70} paddingAngle={3} dataKey="value">{d.defectsByCategory.map((_,i)=><Cell key={i} fill={PIE_COLORS[i]}/>)}</Pie><Tooltip contentStyle={{borderRadius:8,border:"1px solid #e2e8f0",fontSize:12}}/></PieChart></ResponsiveContainer><div className="flex flex-wrap gap-x-3 gap-y-1 mt-1">{d.defectsByCategory.map((c,i)=><span key={i} className="flex items-center gap-1 text-xs text-slate-500"><span className="w-2 h-2 rounded-full" style={{background:PIE_COLORS[i]}}/>{c.name}</span>)}</div></div></div><div className="grid grid-cols-3 gap-4"><div className="col-span-2 bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><div className="flex items-center justify-between mb-3"><h3 className="text-sm font-semibold text-slate-700">Module Health Overview</h3></div><div className="space-y-2.5">{d.moduleHealth.map((m,i)=><div key={i} className="flex items-center gap-3"><span className="text-xs text-slate-600 w-36 truncate font-medium">{m.name}</span><div className="flex-1"><MiniProgressBar value={m.coverage} color={m.coverage>90?"bg-emerald-500":m.coverage>80?"bg-cyan-500":m.coverage>70?"bg-amber-500":"bg-red-500"}/></div><span className="text-xs text-slate-500 w-10 text-right">{m.coverage}%</span><StatusBadge status={m.risk}/></div>)}</div></div><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Live Activity Feed</h3><div className="space-y-2.5 max-h-64 overflow-y-auto pr-1" style={{scrollbarWidth:"thin"}}>{d.activityFeed.map((a,i)=><div key={i} className="flex gap-2 items-start"><div className={`w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 ${a.type==="generation"?"bg-cyan-500":a.type==="ingestion"?"bg-emerald-500":a.type==="defect"?"bg-red-500":a.type==="optimization"?"bg-amber-500":"bg-purple-500"}`}/><div><p className="text-xs text-slate-600 leading-relaxed">{a.text}</p><span className="text-xs text-slate-400">{a.time}</span></div></div>)}</div></div></div></div>);};

const KnowledgePage = () => { const k=MOCK_KNOWLEDGE; const [dragOver,setDragOver]=useState(false); return (<div className="space-y-5"><div className="flex items-center justify-between"><div><h1 className="text-xl font-bold text-slate-800">Knowledge Ingestion</h1><p className="text-sm text-slate-500 mt-0.5">Upload, process, and index domain & testing expertise</p></div><button className="px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium hover:bg-cyan-700 flex items-center gap-2 shadow-sm"><Upload size={14}/>Upload Documents</button></div><div className="grid grid-cols-4 gap-3">{k.stats.map((s,i)=><StatCard key={i} label={s.label} value={s.value} icon={s.icon}/>)}</div><div className="grid grid-cols-3 gap-4"><div className="col-span-2 space-y-4"><div className={`rounded-xl border-2 border-dashed p-8 text-center transition-all cursor-pointer ${dragOver?"border-cyan-400 bg-cyan-50/50":"border-slate-200 bg-slate-50/50 hover:border-cyan-300"}`} onDragOver={e=>{e.preventDefault();setDragOver(true)}} onDragLeave={()=>setDragOver(false)} onDrop={()=>setDragOver(false)}><Upload size={32} className={`mx-auto mb-3 ${dragOver?"text-cyan-500":"text-slate-300"}`}/><p className="text-sm font-medium text-slate-600">Drop files here or click to browse</p><p className="text-xs text-slate-400 mt-1">PDF, PPTX, DOCX, XLSX, MP4, CSV — up to 500MB</p><div className="flex justify-center gap-4 mt-3">{["PDF","PPTX","XLSX","MP4","DOCX"].map(t=><span key={t} className="flex items-center gap-1 text-xs text-slate-400"><FileIcon type={t}/>{t}</span>)}</div></div><div className="bg-white rounded-xl border border-slate-200 shadow-sm"><div className="flex items-center justify-between px-4 py-3 border-b border-slate-100"><h3 className="text-sm font-semibold text-slate-700">Document Library</h3><div className="flex items-center gap-2"><div className="relative"><Search size={14} className="absolute left-2.5 top-2 text-slate-400"/><input className="pl-8 pr-3 py-1.5 text-xs border border-slate-200 rounded-lg bg-slate-50 w-48 focus:outline-none focus:ring-1 focus:ring-cyan-400" placeholder="Search..."/></div><button className="p-1.5 border border-slate-200 rounded-lg hover:bg-slate-50"><Filter size={14} className="text-slate-400"/></button></div></div><div className="divide-y divide-slate-50">{k.documents.map(doc=><div key={doc.id} className="flex items-center px-4 py-3 hover:bg-slate-50/50"><FileIcon type={doc.type}/><div className="ml-3 flex-1 min-w-0"><p className="text-sm font-medium text-slate-700 truncate">{doc.name}</p><p className="text-xs text-slate-400">{doc.module} • {doc.pages?`${doc.pages}p`:"Video"} • {doc.date}</p></div><div className="flex items-center gap-3">{doc.chunks>0&&<span className="text-xs text-slate-400">{doc.chunks} chunks</span>}{doc.confidence>0&&<span className={`text-xs font-medium ${doc.confidence>=90?"text-emerald-500":"text-amber-500"}`}>{doc.confidence}%</span>}<StatusBadge status={doc.status}/></div></div>)}</div></div></div><div className="space-y-4"><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Ingestion Pipeline</h3><div className="space-y-2">{k.ingestionPipeline.map((s,i)=><div key={i} className="flex items-center justify-between"><span className="text-xs text-slate-500">{s.stage}</span><div className="flex items-center gap-2"><div className="w-24"><MiniProgressBar value={s.stage==="Complete"?100:(s.count/20)*100} color={s.stage==="Complete"?"bg-emerald-500":"bg-cyan-500"}/></div><span className="text-xs font-medium text-slate-600 w-12 text-right">{s.count.toLocaleString()}</span></div></div>)}</div></div><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Domain Coverage</h3><div className="space-y-3">{k.domainCoverage.map((d,i)=><div key={i}><div className="flex items-center justify-between mb-1"><span className="text-xs text-slate-600 font-medium">{d.domain}</span><span className="text-xs text-slate-400">{d.docs} docs</span></div><MiniProgressBar value={d.coverage} color={d.coverage>90?"bg-emerald-500":d.coverage>80?"bg-cyan-500":"bg-amber-500"}/></div>)}</div></div></div></div></div>);};

const TestCasePage = () => { const t=MOCK_TESTCASES; const [sd,setSd]=useState(false); return (<div className="space-y-5"><div className="flex items-center justify-between"><div><h1 className="text-xl font-bold text-slate-800">Test Case Generation</h1><p className="text-sm text-slate-500 mt-0.5">AI-generated test cases from ingested domain knowledge</p></div><button className="px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium hover:bg-cyan-700 flex items-center gap-2 shadow-sm"><Zap size={14}/>Generate New Suite</button></div><div className="grid grid-cols-4 gap-3">{t.stats.map((s,i)=><StatCard key={i} label={s.label} value={s.value} icon={s.icon}/>)}</div><div className="grid grid-cols-3 gap-4"><div className="col-span-2 space-y-4"><div className="bg-white rounded-xl border border-slate-200 shadow-sm"><div className="flex items-center justify-between px-4 py-3 border-b border-slate-100"><h3 className="text-sm font-semibold text-slate-700">Recent Test Suites</h3><button className="text-xs text-cyan-600 font-medium">View All →</button></div><div className="divide-y divide-slate-50">{t.recentSuites.map(s=><div key={s.id} className="flex items-center px-4 py-3 hover:bg-slate-50/50 cursor-pointer" onClick={()=>setSd(!sd)}><div className="flex-1 min-w-0"><div className="flex items-center gap-2"><span className="text-xs font-mono text-slate-400">{s.id}</span><StatusBadge status={s.priority}/></div><p className="text-sm font-medium text-slate-700 mt-0.5">{s.name}</p><p className="text-xs text-slate-400">{s.module} • {s.count} tests • {s.generated}</p></div><div className="flex items-center gap-3"><div className="text-right"><span className={`text-sm font-bold ${s.accuracy>=90?"text-emerald-500":s.accuracy>=80?"text-cyan-500":"text-amber-500"}`}>{s.accuracy}%</span><p className="text-xs text-slate-400">accuracy</p></div><StatusBadge status={s.status}/><ChevronRight size={14} className="text-slate-300"/></div></div>)}</div></div>{sd&&<div className="bg-white rounded-xl border border-cyan-200 shadow-sm overflow-hidden"><div className="bg-cyan-50 px-4 py-3 border-b border-cyan-100 flex items-center justify-between"><div><span className="text-xs font-mono text-cyan-600">{t.sampleTestCase.id}</span><h4 className="text-sm font-semibold text-slate-800 mt-0.5">{t.sampleTestCase.title}</h4></div><div className="flex items-center gap-2"><span className="text-xs bg-cyan-100 text-cyan-700 px-2 py-0.5 rounded-full font-medium">{t.sampleTestCase.confidence}%</span><button onClick={()=>setSd(false)} className="p-1 hover:bg-cyan-100 rounded"><X size={14} className="text-slate-400"/></button></div></div><div className="p-4 space-y-3"><div><h5 className="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Preconditions</h5>{t.sampleTestCase.preconditions.map((p,i)=><div key={i} className="flex items-center gap-2 text-xs text-slate-600 mb-1"><CheckCircle size={12} className="text-emerald-500 flex-shrink-0"/>{p}</div>)}</div><div><h5 className="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Test Steps</h5><div className="border border-slate-100 rounded-lg overflow-hidden">{t.sampleTestCase.steps.map(s=><div key={s.step} className={`flex gap-3 px-3 py-2 text-xs ${s.step%2===0?"bg-slate-50/50":""}`}><span className="font-mono text-slate-400 w-4 flex-shrink-0">{s.step}</span><div className="flex-1 font-medium text-slate-700">{s.action}</div><div className="flex-1 text-slate-500 border-l border-slate-100 pl-3">{s.expected}</div></div>)}</div></div><div className="flex items-center gap-2 pt-1"><Database size={12} className="text-cyan-500"/><span className="text-xs text-slate-500">Source: {t.sampleTestCase.source}</span></div><div className="flex gap-1.5">{t.sampleTestCase.tags.map(tg=><span key={tg} className="text-xs bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">#{tg}</span>)}</div></div><div className="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center gap-2"><button className="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-medium flex items-center gap-1.5"><CheckCircle size={12}/>Approve</button><button className="px-3 py-1.5 bg-white border border-slate-200 text-slate-600 rounded-lg text-xs font-medium flex items-center gap-1.5"><MessageSquare size={12}/>Edit</button><button className="px-3 py-1.5 bg-white border border-red-200 text-red-500 rounded-lg text-xs font-medium flex items-center gap-1.5"><X size={12}/>Reject</button></div></div>}</div><div className="space-y-4"><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Generation Modes</h3><div className="space-y-2.5">{t.generationModes.map((m,i)=><div key={i}><div className="flex items-center justify-between mb-1"><span className="text-xs text-slate-600">{m.mode}</span><span className="text-xs font-medium text-slate-500">{m.pct}%</span></div><MiniProgressBar value={m.pct*2} color={PIE_COLORS[i]}/></div>)}</div></div><div className="bg-gradient-to-br from-cyan-600 to-cyan-800 rounded-xl p-4 shadow-sm text-white"><Brain size={24} className="mb-2 text-cyan-200"/><h3 className="text-sm font-semibold mb-1">AI Insight</h3><p className="text-xs text-cyan-100 leading-relaxed">Part Revision: 28% coverage gap in state transition testing. Recommend generating targeted suite for rollback → restore → re-approve flows.</p><button className="mt-3 px-3 py-1.5 bg-white/15 hover:bg-white/25 rounded-lg text-xs font-medium flex items-center gap-1.5"><Zap size={12}/>Generate Suite</button></div></div></div></div>);};

const DefectPage = () => { const df=MOCK_DEFECTS; return (<div className="space-y-5"><div className="flex items-center justify-between"><div><h1 className="text-xl font-bold text-slate-800">Defect Analysis & Insights</h1><p className="text-sm text-slate-500 mt-0.5">AI-powered defect prediction, classification, and trends</p></div><div className="flex items-center gap-2"><button className="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-600 hover:bg-slate-50 flex items-center gap-1.5 shadow-sm"><Download size={12}/>Export</button><button className="px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium hover:bg-cyan-700 flex items-center gap-2 shadow-sm"><Brain size={14}/>Run Prediction</button></div></div><div className="grid grid-cols-4 gap-3">{df.stats.map((s,i)=><StatCard key={i} label={s.label} value={s.value} icon={s.icon}/>)}</div><div className="grid grid-cols-3 gap-4"><div className="col-span-2 space-y-4"><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><div className="flex items-center justify-between mb-3"><h3 className="text-sm font-semibold text-slate-700">Defect Trend</h3><span className="text-xs text-slate-400">Last 8 weeks</span></div><ResponsiveContainer width="100%" height={200}><BarChart data={df.trendData} barGap={2}><CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9"/><XAxis dataKey="week" tick={{fontSize:11,fill:"#94A3B8"}}/><YAxis tick={{fontSize:11,fill:"#94A3B8"}}/><Tooltip contentStyle={{borderRadius:8,border:"1px solid #e2e8f0",fontSize:12}}/><Bar dataKey="found" fill="#0891B2" radius={[3,3,0,0]} name="Found"/><Bar dataKey="predicted" fill="#F59E0B" radius={[3,3,0,0]} name="Predicted"/><Bar dataKey="escaped" fill="#EF4444" radius={[3,3,0,0]} name="Escaped"/></BarChart></ResponsiveContainer></div><div className="bg-white rounded-xl border border-slate-200 shadow-sm"><div className="px-4 py-3 border-b border-slate-100"><h3 className="text-sm font-semibold text-slate-700">Active Defects</h3></div><div className="divide-y divide-slate-50">{df.defects.map(d=><div key={d.id} className="flex items-center px-4 py-3 hover:bg-slate-50/50"><div className="flex-1 min-w-0"><div className="flex items-center gap-2 mb-0.5"><span className="text-xs font-mono text-slate-400">{d.id}</span><StatusBadge status={d.severity}/>{d.predicted&&<span className="flex items-center gap-0.5 text-xs text-purple-500 bg-purple-50 px-1.5 py-0.5 rounded-full border border-purple-200"><Brain size={10}/>AI</span>}</div><p className="text-sm text-slate-700">{d.title}</p><p className="text-xs text-slate-400 mt-0.5">{d.module} • {d.age}</p></div><div className="flex items-center gap-3">{d.confidence>0&&<span className="text-xs text-slate-400">{d.confidence}%</span>}<StatusBadge status={d.status}/></div></div>)}</div></div></div><div className="space-y-4"><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Risk Hotspots</h3><div className="space-y-3">{df.hotspots.map((h,i)=><div key={i} className="flex items-center gap-3"><div className={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold ${h.score>80?"bg-red-100 text-red-600":h.score>60?"bg-amber-100 text-amber-600":"bg-emerald-100 text-emerald-600"}`}>{h.score}</div><div className="flex-1 min-w-0"><p className="text-xs font-medium text-slate-700 truncate">{h.module}</p><p className="text-xs text-slate-400">{h.defects} defects • {h.trend}</p></div>{h.trend==="rising"?<TrendingUp size={14} className="text-red-400"/>:h.trend==="falling"?<TrendingDown size={14} className="text-emerald-400"/>:<Activity size={14} className="text-amber-400"/>}</div>)}</div></div><div className="bg-white rounded-xl border border-slate-200 p-4 shadow-sm"><h3 className="text-sm font-semibold text-slate-700 mb-3">Root Causes</h3><div className="space-y-2.5">{df.rootCauses.map((r,i)=><div key={i}><div className="flex items-center justify-between mb-1"><span className="text-xs text-slate-600">{r.cause}</span><span className="text-xs text-slate-400">{r.count}</span></div><MiniProgressBar value={r.pct*3.3} color={PIE_COLORS[i]}/></div>)}</div></div><div className="bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl p-4 shadow-sm text-white"><AlertTriangle size={22} className="mb-2 text-amber-200"/><h3 className="text-sm font-semibold mb-1">Prediction Alert</h3><p className="text-xs text-amber-100 leading-relaxed">Part Revision: 92% risk score, rising. Expect 5–8 additional defects next sprint.</p></div></div></div></div>);};

/* ═══════════════════════════════════════════════════════════════ */
/*  DASHBOARD SHELL                                                */
/* ═══════════════════════════════════════════════════════════════ */
const NAV_ITEMS = [
  {id:"dashboard",label:"Dashboard",icon:BarChart3,section:"OVERVIEW"},{id:"knowledge",label:"Knowledge Base",icon:Brain,section:"OVERVIEW"},
  {id:"testcases",label:"Test Generation",icon:Zap,section:"QA CAPABILITIES"},{id:"defects",label:"Defect Analysis",icon:Bug,section:"QA CAPABILITIES"},
  {id:"regression",label:"Regression",icon:GitBranch,section:"QA CAPABILITIES",disabled:true},{id:"execution",label:"Execution",icon:Play,section:"QA CAPABILITIES",disabled:true},{id:"reporting",label:"Reports",icon:FileText,section:"QA CAPABILITIES",disabled:true},
  {id:"settings",label:"Settings",icon:Settings,section:"SYSTEM"},{id:"governance",label:"Governance",icon:Shield,section:"SYSTEM",disabled:true},
];

const DashboardShell = ({ onBack }) => {
  const [ap,setAp]=useState("dashboard"); const [sc,setSc]=useState(false); const [time,setTime]=useState(new Date());
  useEffect(()=>{const t=setInterval(()=>setTime(new Date()),60000);return()=>clearInterval(t)},[]);
  const pages={dashboard:<DashboardPage/>,knowledge:<KnowledgePage/>,testcases:<TestCasePage/>,defects:<DefectPage/>};
  let cs="";
  return (<div className="flex h-screen overflow-hidden"><aside className={`${sc?"w-16":"w-56"} bg-slate-900 flex flex-col transition-all duration-200 flex-shrink-0`}><div className="p-4 flex items-center gap-3 border-b border-slate-800"><div className="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center flex-shrink-0 cursor-pointer" onClick={onBack} title="Back to landing"><Brain size={18} className="text-white"/></div>{!sc&&<div className="min-w-0"><h2 className="text-sm font-bold text-white truncate leading-tight cursor-pointer" onClick={onBack}>QA Worker</h2><p className="text-xs text-slate-500 truncate">AI Virtual Agent</p></div>}</div><nav className="flex-1 py-3 px-2 space-y-0.5 overflow-y-auto" style={{scrollbarWidth:"none"}}>{NAV_ITEMS.map(item=>{const sh=item.section!==cs;if(sh)cs=item.section;return(<div key={item.id}>{sh&&!sc&&<p className="text-xs font-semibold text-slate-600 uppercase tracking-wider px-2 pt-4 pb-1.5">{item.section}</p>}<button onClick={()=>!item.disabled&&setAp(item.id)} className={`w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-all ${ap===item.id?"bg-cyan-600/20 text-cyan-400":item.disabled?"text-slate-600 cursor-not-allowed":"text-slate-400 hover:bg-slate-800 hover:text-slate-200"}`} disabled={item.disabled}><item.icon size={16} className="flex-shrink-0"/>{!sc&&<><span className="truncate">{item.label}</span>{item.disabled&&<span className="text-xs text-slate-600 ml-auto">Soon</span>}</>}</button></div>)})}</nav><div className={`p-3 border-t border-slate-800 ${sc?"text-center":""}`}><button onClick={()=>setSc(!sc)} className="w-full flex items-center justify-center gap-2 px-2 py-1.5 text-slate-500 hover:text-slate-300 rounded-lg hover:bg-slate-800 transition-colors">{sc?<ChevronRight size={14}/>:<><ChevronDown size={14} className="rotate-90"/><span className="text-xs">Collapse</span></>}</button></div></aside><main className="flex-1 flex flex-col overflow-hidden bg-slate-50"><header className="h-13 bg-white border-b border-slate-200 flex items-center justify-between px-5 flex-shrink-0"><div className="flex items-center gap-3"><div className="relative"><Search size={15} className="absolute left-2.5 top-2.5 text-slate-400"/><input className="pl-8 pr-3 py-2 text-sm border border-slate-200 rounded-lg bg-slate-50 w-72 focus:outline-none focus:ring-2 focus:ring-cyan-400/30 focus:border-cyan-400" placeholder="Search across all modules..."/></div></div><div className="flex items-center gap-3"><button onClick={onBack} className="text-xs text-slate-400 hover:text-cyan-600 flex items-center gap-1 transition-colors"><Globe size={12}/>Landing Page</button><span className="text-xs text-slate-400">{time.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span><button className="relative p-2 hover:bg-slate-100 rounded-lg"><Bell size={16} className="text-slate-500"/><span className="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"/></button><div className="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center text-white text-xs font-bold">QA</div></div></header><div className="flex-1 overflow-y-auto p-5" style={{scrollbarWidth:"thin"}}>{pages[ap]||<div className="flex items-center justify-center h-full text-slate-400"><div className="text-center"><Settings size={40} className="mx-auto mb-3 text-slate-300"/><p className="text-sm">Coming soon</p></div></div>}</div></main></div>);
};

/* ═══════════════════════════════════════════════════════════════ */
/*  MAIN APP                                                       */
/* ═══════════════════════════════════════════════════════════════ */
export default function App() {
  const [view, setView] = useState("landing");
  return (
    <div style={{fontFamily:"'DM Sans',-apple-system,sans-serif",height:"100vh",overflow:"hidden"}}>
      <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
      {view === "landing" ? <LandingPage onLaunch={() => setView("dashboard")} /> : <DashboardShell onBack={() => setView("landing")} />}
    </div>
  );
}
